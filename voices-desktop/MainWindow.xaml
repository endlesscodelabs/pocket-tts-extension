<Window
    x:Class="VoicesDesktop.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Voices">

    <Grid x:Name="RootGrid" Background="{ThemeResource AppBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /> <!-- Frameless Header Region -->
            <RowDefinition Height="*" />    <!-- Content Area (Elastic) -->
        </Grid.RowDefinitions>

        <!-- Custom Frameless Title Bar (Draggable Region) -->
        <Grid x:Name="AppTitleBar" Grid.Row="0" Height="40" Padding="14,0,0,0" Background="Transparent">
            <!-- App Logo & Brand -->
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Image x:Name="AppLogoImage" Source="Assets/logo_black.png" Width="18" Height="18" VerticalAlignment="Center" />
                <TextBlock Text="Voices" FontWeight="SemiBold" FontSize="13" Foreground="{ThemeResource TextMainBrush}" VerticalAlignment="Center" />
                <Border x:Name="ServerStatusDot" Width="8" Height="8" CornerRadius="4" Background="#10B981" Margin="4,0,0,0" VerticalAlignment="Center" ToolTipService.ToolTip="TTS Server Online (127.0.0.1:8000)" />
            </StackPanel>
        </Grid>

        <!-- Main Content Area with Elastic Grid -->
        <Grid Grid.Row="1" Padding="14,0,14,14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" /> <!-- Audio Card -->
                <RowDefinition Height="Auto" /> <!-- Voice & Speed Card -->
                <RowDefinition Height="*" />    <!-- Selection Preview Card (Fills remaining height) -->
            </Grid.RowDefinitions>

            <!-- 1. Audio Controller & Waveform (ChatGPT Monochrome Style) -->
            <Border Grid.Row="0" Background="{ThemeResource CardBackgroundBrush}" BorderBrush="{ThemeResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,10">
                <StackPanel Spacing="8">
                    <Grid>
                        <TextBlock x:Name="PlaybackStateText" Text="Ready" 
                                   FontSize="11" FontWeight="Normal" Foreground="{ThemeResource TextMutedBrush}" VerticalAlignment="Center" />

                        <!-- Quick Stop & 5-Bar Dynamic Monochrome Waveform -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" VerticalAlignment="Center">
                            <Button x:Name="QuickStopButton" Click="QuickStopButton_Click" ToolTipService.ToolTip="Stop Read Aloud"
                                    Background="{ThemeResource QuickStopBackgroundBrush}" BorderBrush="{ThemeResource QuickStopBorderBrush}" BorderThickness="1" Padding="7,3" CornerRadius="5">
                                <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                    <FontIcon Glyph="&#xE71A;" FontSize="9" Foreground="#EF4444" VerticalAlignment="Center" />
                                    <TextBlock Text="Stop" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource QuickStopForegroundBrush}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <StackPanel Orientation="Horizontal" Spacing="4" Height="18" VerticalAlignment="Center">
                                <Border x:Name="WaveBar1" Width="3" Height="6" CornerRadius="1.5" Background="{ThemeResource WaveBarMutedBrush}" VerticalAlignment="Center" />
                                <Border x:Name="WaveBar2" Width="3" Height="10" CornerRadius="1.5" Background="{ThemeResource WaveBarBrightBrush}" VerticalAlignment="Center" />
                                <Border x:Name="WaveBar3" Width="3" Height="14" CornerRadius="1.5" Background="{ThemeResource WaveBarPeakBrush}" VerticalAlignment="Center" />
                                <Border x:Name="WaveBar4" Width="3" Height="10" CornerRadius="1.5" Background="{ThemeResource WaveBarBrightBrush}" VerticalAlignment="Center" />
                                <Border x:Name="WaveBar5" Width="3" Height="6" CornerRadius="1.5" Background="{ThemeResource WaveBarMutedBrush}" VerticalAlignment="Center" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>

                    <!-- Primary ChatGPT Action Pill Button -->
                    <Button x:Name="PrimaryActionButton" Click="PrimaryActionButton_Click"
                            HorizontalAlignment="Stretch" Height="36" CornerRadius="6"
                            Background="{ThemeResource ActionBtnBackgroundBrush}" Foreground="{ThemeResource ActionBtnForegroundBrush}" BorderThickness="0">
                        <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                            <FontIcon x:Name="ActionBtnIcon" Glyph="&#xE768;" FontSize="11" Foreground="{ThemeResource ActionBtnForegroundBrush}" />
                            <TextBlock x:Name="ActionBtnText" Text="Speak Selection" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource ActionBtnForegroundBrush}" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>

            <!-- 2. Voice & Speed Settings -->
            <Border Grid.Row="1" Background="{ThemeResource CardBackgroundBrush}" BorderBrush="{ThemeResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,10">
                <StackPanel Spacing="10">
                    <!-- Voice Picker -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Voice" FontSize="12" Foreground="{ThemeResource TextMainBrush}" VerticalAlignment="Center" Margin="0,0,10,0" />
                        <ComboBox x:Name="VoiceComboBox" Grid.Column="1" HorizontalAlignment="Stretch" CornerRadius="6"
                                  Background="{ThemeResource InputBackgroundBrush}" BorderBrush="{ThemeResource InputBorderBrush}" Foreground="{ThemeResource TextMainBrush}"
                                  SelectionChanged="VoiceComboBox_SelectionChanged">
                            <ComboBoxItem Content="Alba (Warm, Balanced)" IsSelected="True" Tag="alba" />
                            <ComboBoxItem Content="Fantine (Soft, Melodic)" Tag="fantine" />
                            <ComboBoxItem Content="Jean (Deep, Authoritative)" Tag="jean" />
                            <ComboBoxItem Content="Marius (Clear, Engaging)" Tag="marius" />
                            <ComboBoxItem Content="Javert (Crisp, Formal)" Tag="javert" />
                            <ComboBoxItem Content="Cosette (Bright, Gentle)" Tag="cosette" />
                            <ComboBoxItem Content="Eponine (Expressive, Lively)" Tag="eponine" />
                            <ComboBoxItem Content="Azelma (Playful, Light)" Tag="azelma" />
                        </ComboBox>
                    </Grid>

                    <!-- Speed Slider (Monochrome ChatGPT Styling) -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Speed" FontSize="12" Foreground="{ThemeResource TextMainBrush}" VerticalAlignment="Center" Margin="0,0,10,0" />
                        <Slider x:Name="SpeedSlider" Grid.Column="1" Minimum="0.75" Maximum="2.0" StepFrequency="0.05" Value="1.0"
                                Margin="0,0,8,0" ValueChanged="SpeedSlider_ValueChanged" />
                        <TextBlock x:Name="SpeedLabel" Grid.Column="2" Text="1.00x" FontSize="11" 
                                   Foreground="{ThemeResource TextMutedBrush}" VerticalAlignment="Center" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 3. Selection Preview Area (Elastic, Never Cropped) -->
            <Border Grid.Row="2" Background="{ThemeResource CardBackgroundBrush}" BorderBrush="{ThemeResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12,10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Card Header with Quick Actions -->
                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <TextBlock Text="SELECTION PREVIEW" FontSize="10" FontWeight="SemiBold" Foreground="{ThemeResource TextMutedBrush}" VerticalAlignment="Center" />

                        <!-- Micro-Actions: Copy & Clear -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="4">
                            <Button x:Name="CopyTextButton" Click="CopyTextButton_Click" ToolTipService.ToolTip="Copy text"
                                    Background="Transparent" BorderThickness="0" Padding="4,2" CornerRadius="4">
                                <FontIcon Glyph="&#xE8C8;" FontSize="11" Foreground="{ThemeResource TextMutedBrush}" />
                            </Button>
                            <Button x:Name="ClearTextButton" Click="ClearTextButton_Click" ToolTipService.ToolTip="Clear text"
                                    Background="Transparent" BorderThickness="0" Padding="4,2" CornerRadius="4">
                                <FontIcon Glyph="&#xE74D;" FontSize="11" Foreground="{ThemeResource TextMutedBrush}" />
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- Text Area (Auto-stretches to fill remaining space, clean scrollbar) -->
                    <TextBox x:Name="CapturedTextBox" Grid.Row="1"
                             AcceptsReturn="True" TextWrapping="Wrap"
                             VerticalAlignment="Stretch"
                             CornerRadius="6"
                             FontSize="12"
                             Padding="8"
                             PlaceholderText="Highlight text anywhere and press Alt + C to listen..." />
                </Grid>
            </Border>

        </Grid>
    </Grid>
</Window>
